  "accent": {
    "default": "#2F5BD3",
    "presets": [
      "#2F5BD3",
      "#C2410C",
      "#0F766E",
      "#1C1C1A"
    ],
    "darkLift": {
      "#2F5BD3": "#8AA6F2",
      "#C2410C": "#F4955F",
      "#0F766E": "#4CC3B2",
      "#1C1C1A": "#E6E6E1"
    },
    "derived": {
      "onAccent": "white or #111111, whichever has the higher contrast against the accent",
      "sel": "mix(bg, accent, 10% light / 20% dark) — selected rows and the active nav item",
      "selLine": "mix(bg, accent, 30% light / 45% dark) — selected card outline"
    }
  },
  "radius": {
    "window": 12,
    "panel": 12,
    "control": 8,
    "segmentInner": 6,
    "small": 4,
    "pill": "50%",
    "rule": "inner = outer − padding, never below 4"
  },
  "space": {
    "grid": 4,
    "titleBar": 44,
    "statusBar": 32,
    "toastOffsetBelowTitleBar": 12
  },
  "font": {
    "ui": "Inter, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, Menlo, Consolas, 'PingFang SC', 'Microsoft YaHei', monospace",
    "editorSize": 13.5,
    "uiSize": 13,
    "smallSize": 12,
    "lineHeightEditor": 22,
    "numbers": "font-variant-numeric: tabular-nums for counters and times",
    "cjk": "text-autospace: normal; no hand-typed spaces between Chinese and Latin in string files"
  },
  "motion": {
    "toastIn": "500ms",
    "toastOut": "220ms",
    "statusToast": "3–5s",
    "undoToast": ">=5s with visible countdown",
    "copiedButton": "2s",
    "todoSettle": "900ms",
    "holdModHint": "500ms hold",
    "deleteFade": "220ms + 4% shrink",
    "reducedMotion": "keep state change, ~150ms cross-fade only"
  }
}